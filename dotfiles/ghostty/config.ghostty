font-family = JetBrainsMono Nerd Font
font-style = SemiBold
theme = Nord

# Always route `ghostty` launches (e.g. niri's Mod+T spawn) to the running
# instance instead of only when started by a launcher/D-Bus.
gtk-single-instance = true
# Keep the background instance alive after the last window closes, otherwise
# the next window would cold-start GTK again.
quit-after-last-window-closed = false
