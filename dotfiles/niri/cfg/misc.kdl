    prefer-no-csd
    screenshot-path null

    // environment {} is generated per host by nix/modules/desktop/niri.nix
    // into ./env.kdl — GDK_SCALE differs between the laptop and the PC.

    cursor {
        xcursor-theme "capitaine-cursors"
    }

    debug {
        // Allows notification actions and window activation from Noctalia.
        honor-xdg-activation-with-invalid-serial
    }

    hotkey-overlay {
       skip-at-startup
    }
