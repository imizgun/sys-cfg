# snapper config for /home — managed by sys-cfg (decman/modules/hardware/snapshots.py)
# Unset keys use snapper's built-in defaults (snapper-configs(5)).
SUBVOLUME="/home"
FSTYPE="btrfs"
ALLOW_USERS="%USER%"
SYNC_ACL="yes"

TIMELINE_CREATE="yes"
TIMELINE_CLEANUP="yes"
TIMELINE_LIMIT_HOURLY="0"
TIMELINE_LIMIT_DAILY="7"
TIMELINE_LIMIT_WEEKLY="4"
TIMELINE_LIMIT_MONTHLY="6"
TIMELINE_LIMIT_YEARLY="0"
